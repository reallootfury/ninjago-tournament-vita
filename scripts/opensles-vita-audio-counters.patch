diff --git a/libopensles/IBufferQueue.c b/libopensles/IBufferQueue.c
--- a/libopensles/IBufferQueue.c
+++ b/libopensles/IBufferQueue.c
@@ -20,5 +20,10 @@
 volatile uint32_t opensles_vita_enqueue_count;
 volatile uint32_t opensles_vita_enqueue_failures;
+volatile uint32_t opensles_vita_direct_enqueue_count;
+volatile uint32_t opensles_vita_direct_nonzero_count;
+volatile uint32_t opensles_vita_direct_enqueue_bytes;
+volatile uint32_t opensles_vita_stream_enqueue_count;
+volatile uint32_t opensles_vita_stream_enqueue_bytes;
 volatile uint32_t opensles_vita_last_source_rate;
 volatile uint32_t opensles_vita_last_source_channels;
 volatile uint32_t opensles_vita_last_source_bits;
@@ -194,7 +199,25 @@ SLresult IBufferQueue_Enqueue(SLBufferQueueItf self, const void *pBuffer, SLuint
             opensles_vita_last_source_bits = bits;
             ++opensles_vita_enqueue_count;
             if (SL_OBJECTID_AUDIOPLAYER == InterfaceToObjectID(this)) {
                 CAudioPlayer *audioPlayer = (CAudioPlayer *) this->mThis;
+                SLuint32 locator =
+                    audioPlayer->mDataSource.mLocator.mLocatorType;
+                if (locator == SL_DATALOCATOR_BUFFERQUEUE ||
+                        locator == SL_DATALOCATOR_ANDROIDSIMPLEBUFFERQUEUE) {
+                    ++opensles_vita_direct_enqueue_count;
+                    opensles_vita_direct_enqueue_bytes += output_size;
+                    const uint8_t *samples = (const uint8_t *)pBuffer;
+                    for (uint32_t byte = 0; byte < output_size; ++byte) {
+                        if (samples[byte] != 0) {
+                            ++opensles_vita_direct_nonzero_count;
+                            break;
+                        }
+                    }
+                } else if (locator == SL_DATALOCATOR_URI ||
+                           locator == SL_DATALOCATOR_ANDROIDFD) {
+                    ++opensles_vita_stream_enqueue_count;
+                    opensles_vita_stream_enqueue_bytes += output_size;
+                }
                 audioPlayer->mPlay.mHeadAtEnd = SL_BOOLEAN_FALSE;
                 audioPlayer->mPlay.mHeadStalled = SL_BOOLEAN_FALSE;
             }
